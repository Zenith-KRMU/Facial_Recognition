# =======================================================================
# Dockerfile for Computer Vision Backend
# TensorFlow 2.x, OpenCV 4.x, Flask API, PostgreSQL client
# =======================================================================

FROM python:3.11-slim

# Install system dependencies required by OpenCV and video processing
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    libgl1 \
    libglx-mesa0 \
    libglib2.0-0 \
    libgomp1 \
    libsm6 \
    libxext6 \
    libxrender-dev \
    curl \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Install Python requirements
COPY backend/requirements.txt /app/backend/requirements.txt
RUN pip install --no-cache-dir -r /app/backend/requirements.txt

# Copy backend source code
COPY backend /app/backend

# Expose Flask API port
EXPOSE 5000

ENV PYTHONUNBUFFERED=1
ENV FLASK_HOST=0.0.0.0
ENV FLASK_PORT=5000

# Run with Gunicorn WSGI production server or direct Flask app
CMD ["python", "-m", "backend.app"]
