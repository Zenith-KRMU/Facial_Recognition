# =======================================================================
# Real-time Facial Recognition System for Crowd Dynamics in Public Spaces
# Configuration Environment Variables
# =======================================================================

# 1. Flask & Vision Engine
FLASK_HOST=0.0.0.0
FLASK_PORT=5000
FLASK_DEBUG=True
FLASK_API_URL=http://localhost:5000

# 2. Database Connection
# For PostgreSQL (Docker or local): postgresql://postgres:postgrespassword@localhost:5432/crowd_dynamics
# For local SQLite zero-config development: sqlite:///crowd_vision.db
DATABASE_URL=sqlite:///crowd_vision.db

# 3. Computer Vision & ML Parameters
OPENCV_INFERENCE_WIDTH=640
OPENCV_INFERENCE_HEIGHT=360
DBSCAN_EPS=0.38
DBSCAN_MIN_SAMPLES=1
REID_COSINE_THRESHOLD=0.65
LOITERING_THRESHOLD_SEC=180
STAMPEDE_TURBULENCE_THRESHOLD=0.68

# 4. Optional Gemini AI Intelligence Key for Incident Dispatch Summaries
GEMINI_API_KEY=
